---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import AudioPlayer from '../components/AudioPlayer.astro';
import BottomNav from '../components/BottomNav.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';

interface Props {
	title: string;
	description?: string;
	showNav?: boolean;
	activeNav?: string;
}

const { title, description = "Premium Music Experience", showNav = true, activeNav = 'home' } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<ClientRouter />
		<link rel="preconnect" href="https://www.youtube.com" />
		<link rel="preconnect" href="https://www.youtube-nocookie.com" />
		<link rel="preconnect" href="https://i.ytimg.com" />
		<script src="https://www.youtube.com/iframe_api" async></script>
		<script src="https://accounts.google.com/gsi/client" async defer></script>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet">
		<script is:inline>
			const applyTheme = () => {
				const theme = localStorage.getItem('music-theme') || 'theme-spotify-green';
				const el = document.documentElement;
				// Remove any existing theme- classes
				Array.from(el.classList).forEach(c => {
					if (c.startsWith('theme-')) el.classList.remove(c);
				});
				
				if (theme === 'theme-custom') {
					const customColor = localStorage.getItem('music-theme-custom-color') || '#1ed760';
					el.style.setProperty('--primary', customColor);
					el.style.setProperty('--ring', customColor);
					el.style.setProperty('--sidebar-primary', customColor);
					
					// Contrast text calculation for primary foreground
					const cleanHex = customColor.replace('#', '');
					const r = parseInt(cleanHex.substring(0, 2), 16) || 0;
					const g = parseInt(cleanHex.substring(2, 4), 16) || 0;
					const b = parseInt(cleanHex.substring(4, 6), 16) || 0;
					const yiq = ((r * 299) + (g * 587) + (b * 114)) / 1000;
					const contrast = (yiq >= 128) ? '#000000' : '#ffffff';
					
					el.style.setProperty('--primary-foreground', contrast);
					el.style.setProperty('--sidebar-primary-foreground', contrast);
				} else {
					el.style.removeProperty('--primary');
					el.style.removeProperty('--primary-foreground');
					el.style.removeProperty('--ring');
					el.style.removeProperty('--sidebar-primary');
					el.style.removeProperty('--sidebar-primary-foreground');
					el.classList.add(theme);
				}
				el.classList.add('dark');
			};
			window.applyTheme = applyTheme;
			applyTheme();
			document.addEventListener('astro:after-swap', applyTheme);
			document.addEventListener('astro:page-load', applyTheme);

			// Register service worker for PWA foreground capabilities & clear legacy cache
			if (typeof window !== 'undefined') {
				if ('caches' in window) {
					caches.keys().then(keys => {
						keys.forEach(k => {
							if (k === 'premium-music-cache-v1' || k === 'premium-music-cache-v2') {
								caches.delete(k);
							}
						});
					});
				}
				if ('serviceWorker' in navigator) {
					window.addEventListener('load', () => {
						navigator.serviceWorker.register('/sw.js')
							.then(reg => {
								reg.update();
								console.log('[PWA] Service Worker registered & updated:', reg.scope);
							})
							.catch(err => console.error('[PWA] Service Worker registration failed:', err));
					});
				}
			}
		</script>
	</head>
	<body class="bg-background text-foreground selection:bg-primary/30 antialiased overflow-hidden">
		<!-- Main App Grid Shell -->
		<div class="h-screen w-screen flex flex-col overflow-hidden bg-background">
			<!-- Subtle Background Glow -->
			<div class="fixed inset-0 z-[-1] overflow-hidden pointer-events-none">
				<div class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-primary/10 blur-[120px]"></div>
				<div class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-blue-500/10 blur-[120px]"></div>
			</div>
			
			<!-- Top Half: Sidebar & main content container -->
			<div class="flex-1 flex min-h-0 overflow-hidden relative">
				{showNav && <Sidebar active={activeNav} />}
				
				<!-- Content Center Panel -->
				<div class="flex-1 flex flex-col min-h-0 overflow-hidden relative">
					{showNav && <Header />}
					
					<!-- Scrollable Content Area -->
					<div id="main-content-scrollable" class="flex-1 overflow-y-auto overflow-x-hidden pb-32">
						<slot />
					</div>
				</div>
			</div>

			<!-- Bottom Panel: Persistent Player -->
			{showNav && <AudioPlayer />}

			<!-- Mobile Bottom Navigation Bar -->
			{showNav && <BottomNav active={activeNav} />}
		</div>

		<!-- Native Android App Permission Prompt Modal -->
		<div id="android-permissions-modal" class="fixed inset-0 z-[100] bg-black/85 backdrop-blur-md hidden flex items-end sm:items-center justify-center p-4">
			<div class="bg-card border border-white/10 w-full max-w-md rounded-3xl p-6 sm:p-8 space-y-6 shadow-2xl animate-in fade-in slide-in-from-bottom duration-300">
				<div class="flex items-center gap-3">
					<div class="w-12 h-12 rounded-2xl bg-primary/20 border border-primary/30 flex items-center justify-center text-primary shrink-0">
						<svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
					</div>
					<div>
						<h3 class="text-xl font-black text-white">Music App Permissions</h3>
						<p class="text-xs text-muted-foreground">Enable system features for full mobile playback</p>
					</div>
				</div>

				<div class="space-y-3.5 text-sm">
					<div class="flex items-start gap-3 p-3 rounded-2xl bg-white/5 border border-white/5">
						<span class="text-lg">🎧</span>
						<div>
							<h4 class="font-bold text-white text-xs">Background Playback & Wake Lock</h4>
							<p class="text-[11px] text-muted-foreground">Keep songs streaming uninterrupted when your screen locks or when switching apps.</p>
						</div>
					</div>
					<div class="flex items-start gap-3 p-3 rounded-2xl bg-white/5 border border-white/5">
						<span class="text-lg">📁</span>
						<div>
							<h4 class="font-bold text-white text-xs">Local Device Storage</h4>
							<p class="text-[11px] text-muted-foreground">Download and store high-quality audio tracks directly on your internal storage.</p>
						</div>
					</div>
					<div class="flex items-start gap-3 p-3 rounded-2xl bg-white/5 border border-white/5">
						<span class="text-lg">🔔</span>
						<div>
							<h4 class="font-bold text-white text-xs">Media Controls & Notifications</h4>
							<p class="text-[11px] text-muted-foreground">Show active song info, lock screen playback buttons, and headphone controls.</p>
						</div>
					</div>
				</div>

				<div class="flex flex-col gap-2 pt-2">
					<button id="grant-permissions-btn" class="w-full py-4 bg-primary text-primary-foreground font-black text-sm rounded-2xl hover:scale-[1.02] active:scale-[0.98] transition-all shadow-xl shadow-primary/25 cursor-pointer">
						Grant All Permissions
					</button>
					<button id="skip-permissions-btn" class="w-full py-2.5 text-xs text-muted-foreground hover:text-white font-semibold transition-colors cursor-pointer">
						Later / Continue
					</button>
				</div>
			</div>
		</div>

		<script is:inline>
			function checkAppPermissions() {
				const isConfigured = localStorage.getItem('app_permissions_configured');
				const modal = document.getElementById('android-permissions-modal');
				const isMobileOrCapacitor = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent) || window.Capacitor;
				if (!isConfigured && isMobileOrCapacitor && modal) {
					setTimeout(() => {
						modal.classList.remove('hidden');
					}, 1200);
				}

				const grantBtn = document.getElementById('grant-permissions-btn');
				const skipBtn = document.getElementById('skip-permissions-btn');

				if (grantBtn && !grantBtn.dataset.bound) {
					grantBtn.dataset.bound = "true";
					grantBtn.addEventListener('click', async () => {
						localStorage.setItem('app_permissions_configured', 'true');
						modal?.classList.add('hidden');

						// Request notification permission
						if ('Notification' in window && Notification.permission !== 'granted') {
							try { await Notification.requestPermission(); } catch (e) {}
						}

						// Request WakeLock
						if ('wakeLock' in navigator) {
							try {
								await navigator.wakeLock.request('screen');
							} catch (e) {}
						}
					});
				}

				if (skipBtn && !skipBtn.dataset.bound) {
					skipBtn.dataset.bound = "true";
					skipBtn.addEventListener('click', () => {
						localStorage.setItem('app_permissions_configured', 'true');
						modal?.classList.add('hidden');
					});
				}
			}

			document.addEventListener('astro:page-load', checkAppPermissions);
		</script>
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Geist', sans-serif;
	}
	
	/* Custom Scrollbar */
	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	::-webkit-scrollbar-track {
		background: hsl(var(--background));
	}
	::-webkit-scrollbar-thumb {
		background: hsl(var(--muted-foreground) / 0.2);
		border-radius: 10px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: hsl(var(--muted-foreground) / 0.4);
	}
</style>
