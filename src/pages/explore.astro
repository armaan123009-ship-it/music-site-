---
import Layout from '../layouts/Layout.astro';
import { Compass, Zap, Headphones, Flame, Radio, Sparkles, Music2 } from 'lucide-react';

const exploreCategories = [
    { title: "New Releases", id: "latest", icon: Zap, color: "text-yellow-400", bg: "bg-yellow-500/10" },
    { title: "Top Charts", id: "charts", icon: Flame, color: "text-orange-500", bg: "bg-orange-500/10" },
    { title: "Moods & Genres", id: "genres", icon: Headphones, color: "text-blue-500", bg: "bg-blue-500/10" },
    { title: "Live Signals", id: "live", icon: Radio, color: "text-primary", bg: "bg-primary/10" },
];

const genres = ["All", "Pop", "Hip-Hop", "Rock", "Electronic", "R&B", "Indie", "Chill", "Dance"];
---

<Layout title="Explore Latest Songs | Premium Music" activeNav="explore">
    <div class="p-4 sm:p-8 md:p-12 space-y-10 md:space-y-16">
            <!-- Explore Header -->
            <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                <div>
                    <p class="text-[10px] font-black uppercase tracking-[0.2em] text-primary flex items-center gap-1.5">
                        <Sparkles className="w-3.5 h-3.5" /> Latest Music & Discoveries
                    </p>
                    <h1 class="text-4xl md:text-5xl font-black tracking-tighter text-white mt-1 flex items-center gap-3">
                        <Compass className="w-8 h-8 md:w-10 md:h-10 text-primary" /> Explore
                    </h1>
                </div>
                <!-- Genre Pills Filter -->
                <div class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-hide">
                    {genres.map((g, idx) => (
                        <button class={`genre-filter-btn px-4 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer whitespace-nowrap ${idx === 0 ? 'bg-primary text-primary-foreground shadow-md shadow-primary/20' : 'bg-white/5 hover:bg-white/10 text-white border border-white/5'}`} data-genre={g}>
                            {g}
                        </button>
                    ))}
                </div>
            </div>

            <!-- Explore Highlight Cards -->
            <section class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
                {exploreCategories.map((cat) => (
                    <div class={`explore-category-trigger p-6 md:p-8 rounded-3xl md:rounded-[2.5rem] ${cat.bg} border border-white/5 group cursor-pointer hover:scale-[1.02] transition-all relative overflow-hidden`} data-target={cat.id}>
                        <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-white/5 rounded-full blur-2xl group-hover:scale-150 transition-transform duration-500"></div>
                        <cat.icon className={`w-6 h-6 md:w-8 md:h-8 ${cat.color} mb-3 md:mb-4`} />
                        <h3 class="text-base md:text-xl font-black text-white">{cat.title}</h3>
                        <p class="text-xs text-white/50 mt-1">Discover fresh tracks</p>
                    </div>
                ))}
            </section>

            <!-- Latest Releases & Fresh Drops Section -->
            <section id="latest-releases-section" class="space-y-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-yellow-400">Fresh Drops</p>
                        <h2 class="text-2xl md:text-3xl font-black tracking-tighter text-white">Latest Releases 2026</h2>
                    </div>
                    <span class="text-xs font-bold text-muted-foreground uppercase tracking-wider">Just Added</span>
                </div>
                <div id="latest-releases-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
                    <div class="flex items-center gap-2 opacity-50 col-span-2">
                        <div class="w-4 h-4 rounded-full bg-primary animate-pulse"></div> 
                        <span class="text-xs font-bold uppercase tracking-widest text-white">Loading fresh drops...</span>
                    </div>
                </div>
            </section>

            <!-- Dynamic Trending Charts via API -->
            <section id="trending-section" class="space-y-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-orange-400">Global Hits</p>
                        <h2 class="text-2xl md:text-3xl font-black tracking-tighter text-white">Top Charts & Worldwide Trends</h2>
                    </div>
                </div>
                <div id="explore-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
                    <div class="flex items-center gap-2 opacity-50 col-span-2">
                        <div class="w-4 h-4 rounded-full bg-primary animate-pulse"></div> 
                        <span class="text-xs font-bold uppercase tracking-widest text-white">Fetching trends...</span>
                    </div>
                </div>
            </section>

            <!-- Moods & Genres Dynamic Section -->
            <section id="genre-tracks-section" class="space-y-6">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-blue-400">Vibe Selector</p>
                        <h2 id="genre-section-title" class="text-2xl md:text-3xl font-black tracking-tighter text-white">Curated by Genre</h2>
                    </div>
                </div>
                <div id="genre-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 md:gap-6">
                    <div class="flex items-center gap-2 opacity-50 col-span-2">
                        <div class="w-4 h-4 rounded-full bg-primary animate-pulse"></div> 
                        <span class="text-xs font-bold uppercase tracking-widest text-white">Loading genre selections...</span>
                    </div>
                </div>
            </section>
        </div>
</Layout>

<script>
    import { API_BASE, fetchExplore, fetchTrending } from '../lib/api';

    const escapeAttr = (str: any) => str ? String(str).replace(/"/g, '&quot;') : '';

    const renderTrackCard = (track: any, rank?: number) => `
        <div class="track-trigger group space-y-3 cursor-pointer" data-id="${track.id}" data-title="${escapeAttr(track.title)}" data-artist="${escapeAttr(track.artist)}" data-artist-id="${track.artistId || ''}" data-artwork="${escapeAttr(track.image)}" data-duration="${track.duration || ''}">
            <div class="relative aspect-square rounded-2xl overflow-hidden border border-white/5 shadow-xl bg-white/5">
                <img src="${track.image}" referrerpolicy="no-referrer" class="w-full h-full object-cover group-hover:scale-110 transition-all duration-700 opacity-0" onload="this.classList.remove('opacity-0')" onerror="this.onerror=null; this.src='https://i.ytimg.com/vi/${track.id}/hqdefault.jpg';" />
                ${rank ? `<div class="absolute top-2 left-2 w-6 h-6 rounded-lg bg-black/70 backdrop-blur-md flex items-center justify-center text-[10px] font-black text-white border border-white/10">#${rank}</div>` : ''}
                <div class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                    <div class="w-12 h-12 rounded-full bg-primary flex items-center justify-center shadow-lg shadow-primary/30 group-hover:scale-105 transition-transform">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-foreground translate-x-0.5"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                    </div>
                </div>
            </div>
            <div>
                <h4 class="font-bold text-sm truncate text-white group-hover:text-primary transition-colors">${track.title}</h4>
                <p class="text-xs text-muted-foreground truncate mt-0.5">${track.artist || 'Unknown Artist'}</p>
            </div>
        </div>
    `;

    async function loadExplorePage() {
        const latestGrid = document.getElementById('latest-releases-grid');
        const trendsGrid = document.getElementById('explore-grid');
        const genreGrid = document.getElementById('genre-grid');

        try {
            const data = await fetchExplore();
            if (data) {
                // 1. Latest Releases
                if (latestGrid && data.latest && data.latest.length > 0) {
                    latestGrid.innerHTML = data.latest.slice(0, 12).map((t: any) => renderTrackCard(t)).join('');
                }

                // 2. Charts
                if (trendsGrid && data.charts && data.charts.length > 0) {
                    trendsGrid.innerHTML = data.charts.slice(0, 12).map((t: any, idx: number) => renderTrackCard(t, idx + 1)).join('');
                }

                // 3. Genres
                if (genreGrid && data.genres) {
                    const firstGenre = Object.keys(data.genres)[0];
                    if (firstGenre && data.genres[firstGenre]) {
                        genreGrid.innerHTML = data.genres[firstGenre].slice(0, 12).map((t: any) => renderTrackCard(t)).join('');
                    }
                }
            } else {
                // Fallback to trending
                const trending = await fetchTrending();
                if (trendsGrid && trending.length > 0) {
                    trendsGrid.innerHTML = trending.slice(0, 12).map((t: any, i: number) => renderTrackCard(t, i + 1)).join('');
                }
            }
        } catch (e) {
            console.error('Explore load error:', e);
        }
    }

    async function handleGenreClick(genre: string) {
        const genreGrid = document.getElementById('genre-grid');
        const genreTitle = document.getElementById('genre-section-title');
        if (genreTitle) genreTitle.textContent = `${genre} Highlights`;
        if (genreGrid) {
            genreGrid.innerHTML = `<div class="flex items-center gap-2 opacity-50 col-span-2"><div class="w-4 h-4 rounded-full bg-primary animate-pulse"></div> <span class="text-xs font-bold uppercase tracking-widest text-white">Loading ${genre}...</span></div>`;
        }

        try {
            if (genre === "All") {
                loadExplorePage();
                return;
            }
            const res = await fetch(`${API_BASE}/api/explore?category=${encodeURIComponent(genre.toLowerCase())}`);
            const data = await res.json();
            if (genreGrid && data && data.tracks && data.tracks.length > 0) {
                genreGrid.innerHTML = data.tracks.slice(0, 12).map((t: any) => renderTrackCard(t)).join('');
            }
        } catch (e) {
            console.error('Genre fetch error:', e);
        }
    }

    document.addEventListener('astro:page-load', () => {
        if (window.location.pathname === '/explore') {
            loadExplorePage();

            // Bind genre pills
            document.querySelectorAll('.genre-filter-btn').forEach(btn => {
                const b = btn as HTMLElement;
                if (!b.dataset.bound) {
                    b.dataset.bound = "true";
                    b.addEventListener('click', () => {
                        document.querySelectorAll('.genre-filter-btn').forEach(el => {
                            el.className = 'genre-filter-btn px-4 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer whitespace-nowrap bg-white/5 hover:bg-white/10 text-white border border-white/5';
                        });
                        b.className = 'genre-filter-btn px-4 py-1.5 rounded-full text-xs font-bold transition-all cursor-pointer whitespace-nowrap bg-primary text-primary-foreground shadow-md shadow-primary/20';
                        handleGenreClick(b.dataset.genre || "All");
                    });
                }
            });

            // Bind category cards to scroll down smoothly
            document.querySelectorAll('.explore-category-trigger').forEach(trigger => {
                const t = trigger as HTMLElement;
                if (!t.dataset.bound) {
                    t.dataset.bound = "true";
                    t.addEventListener('click', () => {
                        const targetId = t.dataset.target;
                        if (targetId === "latest") {
                            document.getElementById('latest-releases-section')?.scrollIntoView({ behavior: 'smooth' });
                        } else if (targetId === "charts") {
                            document.getElementById('trending-section')?.scrollIntoView({ behavior: 'smooth' });
                        } else if (targetId === "genres") {
                            document.getElementById('genre-tracks-section')?.scrollIntoView({ behavior: 'smooth' });
                        }
                    });
                }
            });
        }
    });
</script>
