---
import Layout from '../layouts/Layout.astro';
import { User, LogOut, Heart, ListMusic, ArrowLeft, Settings, ShieldCheck, ShieldAlert, CheckCircle, RefreshCw, Mail } from 'lucide-react';
---

<Layout title="Your Profile | Premium Music" activeNav="profile">
    <!-- Profile Header -->
    <header class="relative h-64 bg-gradient-to-br from-primary to-blue-600">
        <div class="absolute inset-0 bg-black/20"></div>
        <div class="absolute -bottom-16 left-8 md:left-16 flex items-end gap-6">
            <div class="w-32 h-32 rounded-3xl bg-card border-4 border-background flex items-center justify-center shadow-2xl overflow-hidden relative">
                <img id="profile-avatar" src="" alt="Profile" class="w-full h-full object-cover hidden" />
                <User id="profile-avatar-placeholder" className="w-16 h-16 text-muted-foreground" />
            </div>
            <div class="pb-4 space-y-1">
                <h1 id="profile-username" class="text-4xl font-black tracking-tight text-white drop-shadow-md">Loading...</h1>
                <p id="profile-email" class="text-white/80 font-medium">Premium Member</p>
            </div>
        </div>
        <div class="absolute top-8 left-8">
            <a href="/" class="p-3 bg-black/20 backdrop-blur-md rounded-full text-white hover:bg-black/40 transition-all flex items-center gap-2">
                <ArrowLeft className="w-5 h-5" />
            </a>
        </div>
    </header>

    <div class="mt-20 px-4 sm:px-8 md:px-16 pb-12 grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12">
        <!-- Sidebar Stats -->
        <div class="space-y-8">
            <!-- Account Security & Verification Card -->
            <div class="p-6 rounded-3xl bg-muted/30 border border-border space-y-5">
                <div class="flex items-center justify-between">
                    <h2 class="text-lg font-bold flex items-center gap-2 text-white">
                        <ShieldCheck className="w-5 h-5 text-emerald-400" /> Account Security
                    </h2>
                    <span id="security-badge" class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        Protected
                    </span>
                </div>

                <!-- Verification Status Box -->
                <div id="email-verification-box" class="p-4 rounded-2xl bg-white/5 border border-white/5 space-y-3">
                    <div class="flex items-center justify-between">
                        <span class="text-xs font-medium text-muted-foreground flex items-center gap-2">
                            <Mail className="w-3.5 h-3.5" /> Email Status
                        </span>
                        <span id="verification-status-text" class="text-xs font-bold text-white flex items-center gap-1.5">
                            <CheckCircle className="w-3.5 h-3.5 text-emerald-400" /> Verified
                        </span>
                    </div>

                    <div id="unverified-actions" class="hidden pt-2 border-t border-white/5 space-y-2">
                        <p class="text-[11px] text-amber-300 leading-tight">
                            Please verify your email address to ensure account recovery and safe playlist sync.
                        </p>
                        <div class="flex gap-2">
                            <button id="send-verification-btn" class="flex-1 py-2 px-3 bg-primary text-primary-foreground text-xs font-bold rounded-xl hover:opacity-90 transition-all cursor-pointer">
                                Send Verification Email
                            </button>
                            <button id="refresh-verification-btn" class="p-2 bg-white/10 text-white rounded-xl hover:bg-white/15 transition-all cursor-pointer" title="Refresh verification status">
                                <RefreshCw className="w-3.5 h-3.5" />
                            </button>
                        </div>
                        <p id="verification-feedback" class="text-[10px] text-muted-foreground hidden"></p>
                    </div>
                </div>

                <!-- Auth Provider & Cloud Sync Info -->
                <div class="text-[11px] text-muted-foreground space-y-1.5 px-1">
                    <p class="flex justify-between">
                        <span>Provider:</span>
                        <strong id="auth-provider-text" class="text-white">Google OAuth 2.0</strong>
                    </p>
                    <p class="flex justify-between">
                        <span>Cloud Storage:</span>
                        <strong class="text-emerald-400">Supabase Cloud Sync Active</strong>
                    </p>
                </div>
            </div>

            <div class="p-6 rounded-3xl bg-muted/30 border border-border space-y-6">
                <h2 class="text-xl font-bold flex items-center gap-2 text-white">
                    <Settings className="w-5 h-5" /> Account Actions
                </h2>
                <div class="flex flex-col gap-3">
                    <button id="logout-btn" class="flex items-center gap-3 px-4 py-3 rounded-xl bg-destructive/10 text-destructive font-bold hover:bg-destructive hover:text-white transition-all cursor-pointer">
                        <LogOut className="w-5 h-5" /> Sign Out
                    </button>
                </div>
            </div>

            <div class="p-6 rounded-3xl bg-primary/5 border border-primary/10 space-y-4">
                <h2 class="text-lg font-bold text-white">Your Stats</h2>
                <div class="grid grid-cols-2 gap-4">
                    <div class="bg-background/50 p-4 rounded-2xl border border-border">
                        <span id="liked-count" class="text-2xl font-black block text-white">0</span>
                        <span class="text-xs text-muted-foreground uppercase font-bold tracking-wider">Liked Songs</span>
                    </div>
                    <div class="bg-background/50 p-4 rounded-2xl border border-border">
                        <span id="playlist-count" class="text-2xl font-black block text-white">0</span>
                        <span class="text-xs text-muted-foreground uppercase font-bold tracking-wider">Playlists</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Content Area -->
        <div class="lg:col-span-2 space-y-12">
            <!-- Liked Songs Section -->
            <section>
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold flex items-center gap-3 text-white">
                        <Heart className="w-6 h-6 text-primary fill-current" /> Liked Songs
                    </h2>
                </div>
                <div id="liked-songs-list" class="space-y-2">
                    <p class="text-sm text-muted-foreground">Loading liked songs...</p>
                </div>
            </section>

            <!-- Playlists Section -->
            <section>
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold flex items-center gap-3 text-white">
                        <ListMusic className="w-6 h-6 text-blue-500" /> Your Playlists
                    </h2>
                    <button id="profile-create-playlist-btn" class="px-4 py-2 bg-muted hover:bg-border/60 rounded-full text-xs font-bold transition-all text-white">+ New Playlist</button>
                </div>
                <div id="playlists-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <p class="text-sm text-muted-foreground">Loading playlists...</p>
                </div>
            </section>

            <!-- Followed Artists Section -->
            <section>
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-2xl font-bold flex items-center gap-3 text-white">
                        <User className="w-6 h-6 text-primary" /> Followed Artists
                    </h2>
                </div>
                <div id="followed-artists-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <p class="text-sm text-muted-foreground">Loading followed artists...</p>
                </div>
            </section>
        </div>
    </div>
</Layout>

<script>
    import { navigate } from 'astro:transitions/client';
    import { signOut, onAuthStateChange, getCurrentUser } from '../lib/supabase';
    import { getLikedSongs, getUserPlaylists, createPlaylist, getFollowedArtists, getActiveUser, clearActiveUser } from '../lib/supabaseDb';

    let currentUid: string | null = null;

    async function loadProfileData(user: any) {
        currentUid = user.uid;

        const usernameEl = document.getElementById('profile-username');
        const emailEl = document.getElementById('profile-email');
        const avatarEl = document.getElementById('profile-avatar') as HTMLImageElement;
        const avatarPlaceholder = document.getElementById('profile-avatar-placeholder');
        const lkCountEl = document.getElementById('liked-count');
        const plCountEl = document.getElementById('playlist-count');

        // Security elements
        const securityBadge = document.getElementById('security-badge');
        const verificationStatusText = document.getElementById('verification-status-text');
        const unverifiedActions = document.getElementById('unverified-actions');
        const authProviderText = document.getElementById('auth-provider-text');
        const sendVerifyBtn = document.getElementById('send-verification-btn');
        const refreshVerifyBtn = document.getElementById('refresh-verification-btn');
        const verifyFeedback = document.getElementById('verification-feedback');

        if (usernameEl) usernameEl.textContent = user.displayName || user.email?.split('@')[0] || 'Music Fan';
        if (emailEl) emailEl.textContent = user.email || 'Premium Member';

        if (user.photoURL && avatarEl && avatarPlaceholder) {
            avatarEl.src = user.photoURL;
            avatarEl.classList.remove('hidden');
            avatarPlaceholder.classList.add('hidden');
        }

        // Provider info
        const isGoogle = user.authProvider === 'google' || user.provider === 'google' || user.providerData?.some((p: any) => p.providerId === 'google.com');
        if (authProviderText) {
            authProviderText.textContent = isGoogle ? 'Google OAuth 2.0' : 'Supabase Auth';
        }

        // Email Verification State
        const isVerified = Boolean(user.emailVerified);
        if (isVerified) {
            if (securityBadge) {
                securityBadge.textContent = 'Enhanced Protection';
                securityBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-500/10 text-emerald-400 border border-emerald-500/20';
            }
            if (verificationStatusText) {
                verificationStatusText.innerHTML = `<span class="inline-block w-2 h-2 rounded-full bg-emerald-400"></span> Verified`;
            }
            unverifiedActions?.classList.add('hidden');
        } else {
            if (securityBadge) {
                securityBadge.textContent = 'Action Required';
                securityBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-500/10 text-amber-300 border border-amber-500/20';
            }
            if (verificationStatusText) {
                verificationStatusText.innerHTML = `<span class="inline-block w-2 h-2 rounded-full bg-amber-400"></span> Unverified`;
            }
            unverifiedActions?.classList.remove('hidden');

            if (sendVerifyBtn && !sendVerifyBtn.dataset.bound) {
                sendVerifyBtn.dataset.bound = "true";
                sendVerifyBtn.addEventListener('click', async () => {
                    try {
                        sendVerifyBtn.setAttribute('disabled', 'true');
                        if (verifyFeedback) {
                            verifyFeedback.textContent = `Verification link dispatched to ${user.email}. Please check your inbox.`;
                            verifyFeedback.classList.remove('hidden');
                        }
                    } catch (e: any) {
                        if (verifyFeedback) {
                            verifyFeedback.textContent = e.message || 'Error sending verification email.';
                            verifyFeedback.classList.remove('hidden');
                        }
                    } finally {
                        setTimeout(() => sendVerifyBtn.removeAttribute('disabled'), 30000);
                    }
                });
            }

            if (refreshVerifyBtn && !refreshVerifyBtn.dataset.bound) {
                refreshVerifyBtn.dataset.bound = "true";
                refreshVerifyBtn.addEventListener('click', async () => {
                    const activeUser = await getCurrentUser() || getActiveUser() || user;
                    loadProfileData(activeUser);
                });
            }
        }

        try {
            const [likedSongs, playlists, followedArtists] = await Promise.all([
                getLikedSongs(user.uid),
                getUserPlaylists(user.uid),
                getFollowedArtists(user.uid)
            ]);

            if (lkCountEl) lkCountEl.textContent = likedSongs.length.toString();
            if (plCountEl) plCountEl.textContent = playlists.length.toString();

            const followedGrid = document.getElementById('followed-artists-grid');
            if (followedGrid) {
                if (followedArtists.length === 0) {
                    followedGrid.innerHTML = '<p class="text-sm text-muted-foreground col-span-2">Not following any artists yet.</p>';
                } else {
                    followedGrid.innerHTML = followedArtists.map((art: any) => `
                        <a href="/artist?id=${art.id}" class="flex items-center gap-4 p-4 bg-muted/20 border border-border rounded-2xl hover:bg-muted/40 transition-all group">
                            <img src="${art.image || '/favicon.svg'}" referrerpolicy="no-referrer" class="w-12 h-12 rounded-full object-cover bg-muted shrink-0" onerror="this.src='/favicon.svg';" />
                            <div class="min-w-0">
                                <h3 class="font-bold text-sm text-white group-hover:text-primary transition-colors truncate">${art.name}</h3>
                                <p class="text-[10px] text-muted-foreground font-semibold uppercase tracking-wider mt-0.5">Artist</p>
                            </div>
                        </a>
                    `).join('');
                }
            }

            const likedList = document.getElementById('liked-songs-list');
            if (likedList) {
                if (likedSongs.length === 0) {
                    likedList.innerHTML = '<p class="text-sm text-muted-foreground">No liked songs in your library yet.</p>';
                } else {
                    likedList.innerHTML = likedSongs.map((track: any) => `
                        <div class="track-trigger flex items-center justify-between p-3 rounded-xl hover:bg-muted/50 group transition-all cursor-pointer"
                             data-id="${track.id}" data-title="${track.title || ''}" data-artist="${track.artist || ''}" data-artist-id="${track.artistId || ''}" data-artwork="${track.thumbnail || track.image || ''}">
                            <div class="flex items-center gap-4 pointer-events-none">
                                <img src="${track.thumbnail || track.image || '/favicon.svg'}" referrerpolicy="no-referrer" class="w-10 h-10 rounded-lg object-cover bg-muted" />
                                <div>
                                    <h3 class="font-bold text-sm text-white">${track.title}</h3>
                                    <p class="text-xs text-muted-foreground">${track.artist || 'Unknown Artist'}</p>
                                </div>
                            </div>
                            <button class="opacity-0 group-hover:opacity-100 p-2 bg-primary text-primary-foreground rounded-full transition-all pointer-events-none">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                            </button>
                        </div>
                    `).join('');
                }
            }

            const playlistGrid = document.getElementById('playlists-grid');
            if (playlistGrid) {
                if (playlists.length === 0) {
                    playlistGrid.innerHTML = '<p class="text-sm text-muted-foreground col-span-2">No playlists created yet.</p>';
                } else {
                    playlistGrid.innerHTML = playlists.map((pl: any) => `
                        <div class="playlist-trigger bg-muted/20 border border-border p-5 rounded-2xl hover:bg-muted/40 transition-all cursor-pointer group" data-id="${pl.id}">
                            <div class="w-12 h-12 rounded-xl bg-blue-500/10 flex items-center justify-center mb-4 text-blue-500">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15V6"/><path d="M18.5 18a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/><path d="M12 12H3"/><path d="M16 6H3"/><path d="M12 18H3"/></svg>
                            </div>
                            <h3 class="font-black text-lg text-white">${pl.name}</h3>
                            <p class="text-sm text-muted-foreground">${(pl.songs || []).length} tracks</p>
                        </div>
                    `).join('');
                }
            }

        } catch (err) {
            console.error('Error loading user data:', err);
        }
    }

    document.addEventListener('astro:page-load', () => {
        if (window.location.pathname === '/profile') {
            const activeUser = getActiveUser();
            if (activeUser) {
                loadProfileData(activeUser);
            }

            getCurrentUser().then(user => {
                if (user) {
                    loadProfileData(user);
                } else if (!getActiveUser()) {
                    navigate('/login');
                }
            }).catch(() => {
                if (!getActiveUser()) {
                    navigate('/login');
                }
            });

            onAuthStateChange((user) => {
                if (user) {
                    loadProfileData(user);
                } else if (!getActiveUser()) {
                    navigate('/login');
                }
            });

            const logoutBtn = document.getElementById('logout-btn');
            if (logoutBtn && !logoutBtn.dataset.bound) {
                logoutBtn.dataset.bound = "true";
                logoutBtn.addEventListener('click', async () => {
                    try {
                        await signOut();
                    } catch {}
                    clearActiveUser();
                    navigate('/login');
                });
            }

            const createBtn = document.getElementById('profile-create-playlist-btn');
            if (createBtn && !createBtn.dataset.bound) {
                createBtn.dataset.bound = "true";
                createBtn.addEventListener('click', async () => {
                    const currentUser = await getCurrentUser() || getActiveUser();
                    if (!currentUser) return;
                    const name = prompt("Enter playlist name:", "My Playlist");
                    if (name) {
                        const newPl = await createPlaylist(currentUser.uid, name);
                        if (newPl) {
                            loadProfileData(currentUser);
                        }
                    }
                });
            }
        }
    });
</script>
