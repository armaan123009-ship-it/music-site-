---
import Layout from '../layouts/Layout.astro';
import { Play, ArrowLeft, MoreHorizontal, Clock, Music } from 'lucide-react';
---

<Layout title="Playlist | Premium Music" activeNav="library">
        <header id="playlist-header" class="relative h-[30vh] md:h-[40vh] min-h-[300px] md:min-h-[400px] flex items-end p-4 sm:p-8 md:p-12 overflow-hidden bg-gradient-to-t from-background to-primary/20">
            <div class="absolute inset-0 z-0">
                <img id="playlist-img" referrerpolicy="no-referrer" src="" class="w-full h-full object-cover blur-3xl opacity-30 transition-opacity duration-500 opacity-0" onload="this.classList.remove('opacity-0')" />
            </div>
            
            <div class="relative z-10 flex flex-col md:flex-row items-end gap-4 md:gap-8 w-full">
                <div class="w-36 h-36 md:w-64 md:h-64 rounded-2xl md:rounded-[2rem] overflow-hidden shadow-2xl bg-white/5 border border-white/10 shrink-0">
                    <img id="playlist-cover" referrerpolicy="no-referrer" src="" class="w-full h-full object-cover transition-opacity duration-500 opacity-0" onload="this.classList.remove('opacity-0')" />
                </div>
                <div class="flex-1 space-y-4">
                    <span class="text-xs font-black uppercase tracking-[0.3em] text-primary">Playlist</span>
                    <h1 id="playlist-title" class="text-5xl md:text-8xl font-black tracking-tighter drop-shadow-2xl text-white">Loading...</h1>
                    <div class="flex items-center gap-4 text-sm font-bold text-white/60">
                        <span id="playlist-user" class="text-white">Premium User</span>
                        <span>•</span>
                        <span id="playlist-count">0 tracks</span>
                    </div>
                    <div class="flex items-center gap-4 pt-4">
                        <button id="play-all-btn" class="px-8 py-4 bg-primary text-primary-foreground font-black rounded-full hover:scale-105 transition-all shadow-xl shadow-primary/20 flex items-center gap-2">
                            <Play className="w-6 h-6 fill-current" /> Play Now
                        </button>
                        <button class="p-4 bg-white/5 hover:bg-white/10 rounded-full border border-white/5 transition-all">
                            <MoreHorizontal className="w-6 h-6 text-white" />
                        </button>
                    </div>
                </div>
            </div>
        </header>

        <div class="p-4 sm:p-8 md:p-12">
            <div class="grid grid-cols-[auto_1fr_auto] gap-4 px-4 py-3 text-[10px] font-black uppercase tracking-widest text-muted-foreground border-b border-white/5 mb-4">
                <div class="w-8 text-center">#</div>
                <div>Title</div>
                <div class="w-12 text-right"><Clock className="w-4 h-4" /></div>
            </div>
            
            <div id="playlist-songs-list" class="space-y-1">
                <!-- Tracks -->
            </div>
        </div>
</Layout>

<script>
    import { navigate } from 'astro:transitions/client';
    import { API_BASE } from '../lib/api';
    import { getCurrentUser } from '../lib/supabase';
    import { getUserPlaylists, getActiveUser, removeSongFromPlaylist, deletePlaylist } from '../lib/supabaseDb';

    const escapeAttr = (str: any) => str ? String(str).replace(/"/g, '&quot;') : '';

    async function loadPlaylist() {
        const urlParams = new URLSearchParams(window.location.search);
        const playlistId = urlParams.get('id');
        
        if (!playlistId) {
            navigate('/');
            return;
        }

        const titleEl = document.getElementById('playlist-title');
        const countEl = document.getElementById('playlist-count');
        const coverEl = document.getElementById('playlist-cover') as HTMLImageElement;
        const imgEl = document.getElementById('playlist-img') as HTMLImageElement;
        const userEl = document.getElementById('playlist-user');
        const list = document.getElementById('playlist-songs-list');
        const playAllBtn = document.getElementById('play-all-btn');

        // Check if this is a user-created custom playlist (starts with pl_)
        if (playlistId.startsWith('pl_') || playlistId.startsWith('user_')) {
            try {
                const user = await getCurrentUser() || getActiveUser();
                let userPl: any = null;

                if (user) {
                    const playlists = await getUserPlaylists(user.uid);
                    userPl = playlists.find(p => p.id === playlistId);
                }

                if (!userPl) {
                    // Check local storage across any key
                    for (let i = 0; i < localStorage.length; i++) {
                        const key = localStorage.key(i);
                        if (key && key.startsWith('local_playlists_')) {
                            try {
                                const arr = JSON.parse(localStorage.getItem(key) || '[]');
                                const found = arr.find((p: any) => p.id === playlistId);
                                if (found) { userPl = found; break; }
                            } catch (e) {}
                        }
                    }
                }

                if (userPl) {
                    if (titleEl) titleEl.textContent = userPl.name;
                    if (userEl) userEl.textContent = user ? (user.displayName || user.email?.split('@')[0] || "You") : "You";
                    const songs = Array.isArray(userPl.songs) ? userPl.songs : [];
                    if (countEl) countEl.textContent = `${songs.length} track${songs.length === 1 ? '' : 's'}`;

                    if (songs.length > 0) {
                        const coverSrc = songs[0].thumbnail || songs[0].image || '/favicon.svg';
                        if (coverEl) {
                            coverEl.classList.add('opacity-0');
                            coverEl.src = coverSrc;
                        }
                        if (imgEl) {
                            imgEl.classList.add('opacity-0');
                            imgEl.src = coverSrc;
                        }
                    }

                    if (list) {
                        if (songs.length === 0) {
                            list.innerHTML = `
                                <div class="text-center py-16 space-y-3">
                                    <p class="text-muted-foreground font-semibold">This playlist has no songs yet.</p>
                                    <p class="text-xs text-muted-foreground/60">Play any track in the app and tap "Add to Playlist" to build your custom collection!</p>
                                </div>
                            `;
                        } else {
                            list.innerHTML = songs.map((track: any, i: number) => `
                                <div class="track-trigger grid grid-cols-[auto_1fr_auto_auto] gap-4 px-4 py-3 rounded-2xl hover:bg-white/5 group transition-all cursor-pointer items-center"
                                     data-id="${track.id}" data-title="${escapeAttr(track.title)}" data-artist="${escapeAttr(track.artist || '')}" data-artist-id="${track.artistId || ''}" data-artwork="${escapeAttr(track.thumbnail || track.image || '')}">
                                    <div class="w-8 text-center text-sm font-bold text-muted-foreground group-hover:text-primary">${i + 1}</div>
                                    <div class="flex items-center gap-4 min-w-0">
                                        <img src="${track.thumbnail || track.image || '/favicon.svg'}" referrerpolicy="no-referrer" class="w-10 h-10 rounded-lg object-cover transition-opacity duration-300 opacity-0 bg-muted" onload="this.classList.remove('opacity-0')" onerror="this.onerror=null; this.src='https://i.ytimg.com/vi/${track.id}/hqdefault.jpg';" />
                                        <div class="min-w-0">
                                            <p class="font-bold text-sm truncate text-white">${track.title}</p>
                                            <p class="text-xs text-muted-foreground truncate">${track.artist || 'Unknown Artist'}</p>
                                        </div>
                                    </div>
                                    <div class="w-12 text-right text-xs font-bold text-muted-foreground">${track.duration || '3:30'}</div>
                                    <button class="remove-song-btn opacity-0 group-hover:opacity-100 p-1.5 hover:bg-white/10 text-muted-foreground hover:text-destructive rounded-lg transition-all" data-song-id="${track.id}" title="Remove from playlist">
                                        ✕
                                    </button>
                                </div>
                            `).join('');

                            // Remove song event delegation
                            list.querySelectorAll('.remove-song-btn').forEach(btn => {
                                btn.addEventListener('click', async (e) => {
                                    e.stopPropagation();
                                    const songId = (btn as HTMLElement).dataset.songId;
                                    if (songId && user) {
                                        await removeSongFromPlaylist(user.uid, playlistId, { id: songId } as any);
                                        loadPlaylist();
                                    }
                                });
                            });
                        }

                        // Play song click handler
                        if (!list.dataset.clicksBound) {
                            list.dataset.clicksBound = "true";
                            list.addEventListener('click', (e) => {
                                const target = e.target as HTMLElement;
                                if (target.closest('.remove-song-btn')) return;
                                const trigger = target.closest('.track-trigger') as HTMLElement;
                                if (trigger) {
                                    const trackId = trigger.dataset.id;
                                    const clickedTrack = songs.find((s: any) => s.id === trackId);
                                    if (clickedTrack) {
                                        window.dispatchEvent(new CustomEvent('play-track', {
                                            detail: {
                                                track: {
                                                    ...clickedTrack,
                                                    image: clickedTrack.thumbnail || clickedTrack.image
                                                },
                                                queue: songs.map((s: any) => ({
                                                    ...s,
                                                    image: s.thumbnail || s.image
                                                }))
                                            }
                                        }));
                                    }
                                }
                            });
                        }
                    }

                    if (playAllBtn && !playAllBtn.dataset.bound) {
                        playAllBtn.dataset.bound = "true";
                        playAllBtn.addEventListener('click', () => {
                            if (songs.length > 0) {
                                window.dispatchEvent(new CustomEvent('play-track', {
                                    detail: {
                                        track: {
                                            ...songs[0],
                                            image: songs[0].thumbnail || songs[0].image
                                        },
                                        queue: songs.map((s: any) => ({
                                            ...s,
                                            image: s.thumbnail || s.image
                                        }))
                                    }
                                }));
                            }
                        });
                    }

                    return;
                }
            } catch (userPlErr) {
                console.warn("User playlist lookup notice:", userPlErr);
            }
        }

        // Standard YouTube / Remote playlist fetch
        try {
            const res = await fetch(`${API_BASE}/api/playlist/${playlistId}`);
            if (!res.ok) throw new Error("Failed to fetch playlist");
            const data = await res.json();
            
            if (titleEl) titleEl.textContent = data.title;
            if (countEl) countEl.textContent = `${data.songs.length} tracks`;
            
            if (data.songs.length > 0) {
                if (coverEl) {
                    coverEl.classList.add('opacity-0');
                    coverEl.src = data.songs[0].image;
                }
                if (imgEl) {
                    imgEl.classList.add('opacity-0');
                    imgEl.src = data.songs[0].image;
                }
            }

            if (list) {
                list.innerHTML = data.songs.map((track: any, i: number) => `
                    <div class="track-trigger grid grid-cols-[auto_1fr_auto] gap-4 px-4 py-3 rounded-2xl hover:bg-white/5 group transition-all cursor-pointer items-center"
                         data-id="${track.id}" data-title="${escapeAttr(track.title)}" data-artist="${escapeAttr(track.artist)}" data-artist-id="${track.artistId || ''}" data-artwork="${escapeAttr(track.image)}" data-custom-play="true">
                        <div class="w-8 text-center text-sm font-bold text-muted-foreground group-hover:text-primary">${i + 1}</div>
                        <div class="flex items-center gap-4 min-w-0">
                            <img src="${track.image}" referrerpolicy="no-referrer" class="w-10 h-10 rounded-lg object-cover transition-opacity duration-300 opacity-0" onload="this.classList.remove('opacity-0')" onerror="this.onerror=null; this.src='https://i.ytimg.com/vi/${track.id}/hqdefault.jpg';" />
                            <div class="min-w-0">
                                <p class="font-bold text-sm truncate text-white">${track.title}</p>
                                <p class="text-xs text-muted-foreground truncate">${track.artist}</p>
                            </div>
                        </div>
                        <div class="w-12 text-right text-xs font-bold text-muted-foreground">${track.duration || '3:45'}</div>
                    </div>
                `).join('');

                // Event delegation for song clicks to load the entire playlist as queue context
                if (!list.dataset.clicksBound) {
                    list.dataset.clicksBound = "true";
                    list.addEventListener('click', (e) => {
                        const target = e.target as HTMLElement;
                        const trigger = target.closest('.track-trigger') as HTMLElement;
                        if (trigger) {
                            const trackId = trigger.dataset.id;
                            const clickedTrack = data.songs.find((s: any) => s.id === trackId);
                            if (clickedTrack) {
                                window.dispatchEvent(new CustomEvent('play-track', {
                                    detail: {
                                        track: clickedTrack,
                                        queue: data.songs
                                    }
                                }));
                            }
                        }
                    });
                }
            }

            if (playAllBtn && !playAllBtn.dataset.bound) {
                playAllBtn.dataset.bound = "true";
                playAllBtn.addEventListener('click', () => {
                    if (data.songs.length > 0) {
                        window.dispatchEvent(new CustomEvent('play-track', {
                            detail: {
                                track: data.songs[0],
                                queue: data.songs
                            }
                        }));
                    }
                });
            }

        } catch (e) {
            console.error('Failed to load playlist:', e);
            if (titleEl) titleEl.textContent = "Playlist Not Found";
            if (countEl) countEl.textContent = "0 tracks";
        }
    }

    document.addEventListener('astro:page-load', () => {
        if (window.location.pathname === '/playlist') {
            loadPlaylist();
        }
    });
</script>
